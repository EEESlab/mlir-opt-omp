# local.env for lucap's WSL dev box (iomp / libgomp on the host).
#
# To use it, copy it to the repo root as `local.env`:
#   cp docs/setups/lucap-wsl.env local.env
#
# Setting up a new machine? Start from the generic template instead:
#   cp local.env.example local.env
# All variables and their defaults are in the "Configuration reference" section
# of test/Integration/README.md.

LLVM_BIN="$HOME/eeeslab/llvm-project/build/bin"
OMP_TOOL_BIN="$HOME/eeeslab/mlir-opt-omp/build"

# The clang->CIR front-end needs the OpenMP headers of the local GCC (13 here).
INC_OMP="/usr/lib/gcc/x86_64-linux-gnu/13/include"

# External PolyBench checkout, only needed for SUITE=full.
POLYBENCH="$HOME/eeeslab/PolyBenchC-4.2.1-OpenMP"

# No pmsis on this box: the PULP_* variables stay unset.
#
# The run parameters this machine used (RUNTIME=iomp, SUITE=bundled,
# THREADS=16) are all defaults, so test/Integration/config.env is not needed.
