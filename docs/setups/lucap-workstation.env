# local.env for the "lucap workstation" (ZWorkstation, Ubuntu).
# Covers all three runtimes; pick one with RUNTIME=... at launch.
#
# To use it, copy it to the repo root as `local.env`:
#   cp docs/setups/lucap-workstation.env local.env
#
# Setting up a new machine? Start from the generic template instead:
#   cp local.env.example local.env
# All variables and their defaults are in the "Configuration reference" section
# of test/Integration/README.md.

LLVM_BIN="/home/tagliavini/MLIR/INSTALL-LLVM/bin"   # LLVM is on the tagliavini user
OMP_TOOL_BIN="$HOME/mlir-opt-omp/build"             # mlir-opt-omp on the parigi user

# The clang->CIR front-end needs the OpenMP headers of the local GCC (12 here).
INC_OMP="/usr/lib/gcc/x86_64-linux-gnu/12/include"

POLYBENCH="$HOME/PolyBenchC-4.2.1-OpenMP"
RULES="$HOME/mlir-opt-omp/rules.dsl"

# --- PULP / gvsoc (RUNTIME=pmsis) --------------------------------------------
PULP_APP_DIR="$POLYBENCH"
PULP_TOOLCHAIN_BIN="/home/tagliavini/toolchains/gap_riscv_toolchain_ubuntu/INSTALL/bin"
PULP_SDK_ENV="/home/tagliavini/gap8/gap_sdk/configs/gap8_v3.sh"
# riscv32 opt/llc with the xpulpv backend — a different LLVM install than above:
PULP_OPT="/home/tagliavini/toolchains/llvm-project/builds/INSTALL-REBASE/bin/opt"
PULP_LLC="/home/tagliavini/toolchains/llvm-project/builds/INSTALL-REBASE/bin/llc"

# --- Run parameters this machine used ----------------------------------------
# These belong in test/Integration/config.env, not here:
#   SUITE="full"              # the whole external PolyBench suite
#   DATASET="LARGE_DATASET"   # meaningful parallel timings (pmsis: MINI)
