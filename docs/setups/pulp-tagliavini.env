# local.env for the PULP/gvsoc target (RUNTIME=pmsis) on tagliavini's setup.
# Same variables as lucap-workstation.env — only the paths differ; fill in the
# ones marked ADJUST.
#
# To use it, copy it to the repo root as `local.env`:
#   cp docs/setups/pulp-tagliavini.env local.env
#
# Setting up a new machine? Start from the generic template instead:
#   cp local.env.example local.env
# All variables and their defaults are in the "Configuration reference" section
# of test/Integration/README.md.

# --- Host tools --------------------------------------------------------------
# clang-cir, cir-opt, mlir-opt, mlir-translate. ADJUST:
LLVM_BIN="$HOME/toolchains/llvm-project/builds/INSTALL-CIR/bin"
# mlir-opt-omp build dir (the legacy scripts used grammar/mlir-transform):
OMP_TOOL_BIN="$HOME/grammar/mlir-transform/BUILD"
RULES="$HOME/grammar/mlir-transform/rules.dsl"
# The clang->CIR front-end needs the OpenMP headers of the local GCC (12 here).
INC_OMP="/usr/lib/gcc/x86_64-linux-gnu/12/include"

# --- riscv32 backend (xpulpv) ------------------------------------------------
# The opt/llc that produce kernel.o:
PULP_OPT="/home/tagliavini/toolchains/llvm-project/builds/INSTALL-REBASE/bin/opt"
PULP_LLC="/home/tagliavini/toolchains/llvm-project/builds/INSTALL-REBASE/bin/llc"
# GAP RISC-V GCC toolchain used by the PULP-SDK make. ADJUST:
PULP_TOOLCHAIN_BIN="$HOME/toolchains/gap_riscv_toolchain_ubuntu/INSTALL/bin"

# --- PULP harness ------------------------------------------------------------
# Directory with the PolyBench-PULP PULP-SDK Makefile. ADJUST:
PULP_APP_DIR="$HOME/PolyBenchC-PULP"
POLYBENCH="$PULP_APP_DIR"
# GAP SDK environment, sourced automatically. Comment it out to source it
# yourself before running. ADJUST:
PULP_SDK_ENV="$HOME/gap8/gap_sdk/configs/gap8_v3.sh"

# --- Run parameters this machine used ----------------------------------------
# These belong in test/Integration/run.env, not here:
#   RUNTIME="pmsis"
#   SUITE="full"
#   DATASET="MINI_DATASET"    # must match the harness Makefile's native builds
