# Per-machine configuration for the PULP/gvsoc target (RUNTIME=pmsis) on
# tagliavini's setup. Same variables as config.env.pulp-workstation.example —
# only the paths differ; fill in the ones marked ADJUST.
#
# To use it, copy it to `config.env` (same directory):
#   cp config.env.pulp-tagliavini.example config.env
#
# `config.env` is git-ignored, so your local paths never get committed.
# Anything you export in your shell before running the script overrides these.

# --- Tool directories (prepended to PATH if set) ---------------------------
# Host LLVM/CIR tools (clang-cir, cir-opt, mlir-opt, mlir-translate). ADJUST:
LLVM_BIN="$HOME/toolchains/llvm-project/builds/INSTALL-CIR/bin"
# mlir-opt-omp build directory (the legacy scripts used grammar/mlir-transform):
OMP_TOOL_BIN="$HOME/grammar/mlir-transform/BUILD"
# GAP RISC-V GCC toolchain used by the PULP-SDK make (prepended to PATH). ADJUST:
PULP_TOOLCHAIN_BIN="$HOME/toolchains/gap_riscv_toolchain_ubuntu/INSTALL/bin"

# --- riscv32 backend (xpulpv) -----------------------------------------------
# The llc/opt that produce kernel.o (RISC-V + xpulpv backend):
PULP_OPT="/home/tagliavini/toolchains/llvm-project/builds/INSTALL-REBASE/bin/opt"
PULP_LLC="/home/tagliavini/toolchains/llvm-project/builds/INSTALL-REBASE/bin/llc"
# PULP_OPT_FLAGS=""    # host 'opt' pass on the .ll; none by default
# PULP_LLC_FLAGS="-O3 -mtriple=riscv32-unknown-elf -mattr=+m,+c,+xpulpv -relocation-model=pic"

# --- PULP harness ------------------------------------------------------------
# Directory with the PolyBench-PULP PULP-SDK Makefile (where the legacy
# run_tests_gvsoc.sh + compile-pulp.sh lived). ADJUST:
PULP_APP_DIR="$HOME/PolyBenchC-PULP"
POLYBENCH="$PULP_APP_DIR"
# GAP SDK environment, sourced automatically by common.sh. Alternatively
# comment this out and source it yourself before running. ADJUST:
PULP_SDK_ENV="$HOME/gap8/gap_sdk/configs/gap8_v3.sh"
# PULP_PLATFORM="gvsoc"     # gvsoc | board
# PULP_BUILD_BIN="BUILD/GAP8_V3/GCC_RISCV_PULPOS/test"
# PULP_POLYBENCH_DEFS="-DPOLYBENCH_DUMP_ARRAYS -DPOLYBENCH_TIME"
# PULP_VERBOSE=1            # stream the make/gvsoc output instead of logging only

# --- Paths -------------------------------------------------------------------
RULES="$HOME/grammar/mlir-transform/rules.dsl"
# OpenMP headers used by the clang->CIR front-end (gcc-12 on this machine):
INC_OMP="/usr/lib/gcc/x86_64-linux-gnu/12/include"
# OUTDIR="$PWD/results"

# --- Run parameters ----------------------------------------------------------
RUNTIME="pmsis"
DATASET="MINI_DATASET"    # must match the harness Makefile's native builds
SUITE="full"
# PLOT="true"             # render results/<runtime>/results_performance.png at
#                         # the end (needs python3 + matplotlib)
# KERNELS="linear-algebra/blas/gemm/gemm-omp.c ..."  # explicit list overrides SUITE
