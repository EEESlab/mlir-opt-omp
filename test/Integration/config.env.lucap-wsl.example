# Per-machine configuration for run_correctness.sh and run_performance.sh.
#
# Copy this file to `config.env` (same directory) and adjust to your setup:
#   cp config.env.example config.env


# --- Tool directories (prepended to PATH if set) ---------------------------
# Point these at your LLVM/CIR build and the mlir-opt-omp build directory.
LLVM_BIN="$HOME/eeeslab/llvm-project/build/bin"
OMP_TOOL_BIN="$HOME/eeeslab/mlir-opt-omp/build"

# --- Paths -----------------------------------------------------------------
POLYBENCH="$HOME/eeeslab/PolyBenchC-4.2.1-OpenMP"
# POLYBENCH_UTIL="$POLYBENCH/utilities"     # defaults to $POLYBENCH/utilities
# RULES="$HOME/eeeslab/mlir-opt-omp/rules.dsl"  # defaults to repo rules.dsl
# OpenMP headers used by the clang->CIR front-end (match your GCC version):
INC_OMP="/usr/lib/gcc/x86_64-linux-gnu/13/include"
# OUTDIR="$PWD/results"                      # where binaries/dumps/CSV land

# --- Run parameters --------------------------------------------------------
RUNTIME="iomp"            # iomp | libgomp
DATASET="MINI_DATASET"    # MINI_/SMALL_/STANDARD_/LARGE_/EXTRALARGE_DATASET
THREADS="16"              # threads for parallel runs (par cells / correctness)
SUITE="bundled"           # bundled (vendored kernels) | full (needs external POLYBENCH)
# KERNELS="linear-algebra/blas/gemm/gemm-omp.c ..."  # explicit list overrides SUITE

# --- Performance-only parameters (run_performance.sh) ----------------------
# Use a larger DATASET (e.g. LARGE_DATASET) for meaningful parallel timings.
# REPS="5"                  # timed runs per cell; min+max dropped, mean of rest
# VARIANCE_ACCEPTED="5"     # warn if a cell's relative std-dev exceeds this %
# PLOT="true"               # render results/<runtime>/results_performance_<sel>.png at the end
#                           # (per-kernel speedup bars for the SUITE that ran;
#                           #  needs python3 + matplotlib — see lib/plot_speedup.py)

# --- Misc ------------------------------------------------------------------
# Running as root auto-adds -DPOLYBENCH_LINUX_FIFO_SCHEDULER and -lc. To force
# the link flags yourself (or disable the auto behaviour), set:
# POLYBENCH_LFLAGS="-lc"

# --- Strict FP flags (advanced) --------------------------------------------
# Defaults already enforce bit-identical results; override only if you know why.
# CLANG_STRICT_FP="-ffp-contract=off -fno-vectorize -fno-slp-vectorize"
# GCC_STRICT_FP="-ffp-contract=off -fno-tree-vectorize -fno-tree-loop-vectorize -fno-tree-slp-vectorize"
