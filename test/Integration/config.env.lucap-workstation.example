# Per-machine configuration for the "lucap workstation" (Ubuntu, x86).
# This is the machine that ran the legacy run_tests_iomp.sh / run_tests_gomp.sh
# drivers. It is the counterpart of config.env.example, which describes the
# "lucap wsl" setup ($HOME/eeeslab/... layout, gcc-13).
#
# Both run_correctness.sh and run_performance.sh read this file via common.sh.
# To use it on the workstation, copy it to `config.env` (same directory):
#   cp config.env.lucap-workstation.example config.env
#
# `config.env` is git-ignored, so your local paths never get committed.
# Anything you export in your shell before running the script overrides these.

# --- Tool directories (prepended to PATH if set) ---------------------------
# On the workstation LLVM/CIR and mlir-opt-omp are installed into the same
# INSTALL-LLVM/bin (this is what the legacy scripts put on PATH).
LLVM_BIN="/home/tagliavini/MLIR/INSTALL-LLVM/bin"
OMP_TOOL_BIN="/home/tagliavini/MLIR/INSTALL-LLVM/bin"

# --- Individual tool overrides (optional) ----------------------------------
# Only needed if a tool is not reachable via the dirs above / your PATH,
# or to pin a specific version (e.g. the libgomp reference compiler).
# CLANG=clang
# GCC=gcc-12
# OPT=opt
# LLC=llc
# CIR_OPT=cir-opt
# MLIR_OPT=mlir-opt
# MLIR_TRANSLATE=mlir-translate
# MLIR_OPT_OMP=mlir-opt-omp

# --- Paths -----------------------------------------------------------------
POLYBENCH="$HOME/PolyBenchC-4.2.1-OpenMP"
# POLYBENCH_UTIL="$POLYBENCH/utilities"     # defaults to $POLYBENCH/utilities
RULES="$HOME/rules.dsl"                     # workstation keeps rules.dsl in $HOME
# OpenMP headers used by the clang->CIR front-end (workstation ships gcc-12):
INC_OMP="/usr/lib/gcc/x86_64-linux-gnu/12/include"
# OUTDIR="$PWD/results"                      # where binaries/dumps/CSV land

# --- Run parameters --------------------------------------------------------
RUNTIME="iomp"            # iomp | libgomp
DATASET="LARGE_DATASET"   # MINI_/SMALL_/STANDARD_/LARGE_/EXTRALARGE_DATASET
THREADS="16"              # threads for parallel runs (par cells / correctness)
SUITE="full"              # full: run the whole external PolyBench suite (29 kernels)
# KERNELS="linear-algebra/blas/gemm/gemm-omp.c ..."  # explicit list overrides SUITE

# --- Performance-only parameters (run_performance.sh) ----------------------
# LARGE_DATASET above already gives meaningful parallel timings.
# REPS="5"                  # timed runs per cell; min+max dropped, mean of rest
# VARIANCE_ACCEPTED="5"     # warn if a cell's relative std-dev exceeds this %
# PLOT="true"               # render results/results_performance.png at the end
#                           # (per-kernel speedup bars for the SUITE that ran;
#                           #  needs python3 + matplotlib — see plot_speedup.py)

# --- Misc ------------------------------------------------------------------
# Running as root auto-adds -DPOLYBENCH_LINUX_FIFO_SCHEDULER and -lc. To force
# the link flags yourself (or disable the auto behaviour), set:
# POLYBENCH_LFLAGS="-lc"

# --- Strict FP flags (advanced) --------------------------------------------
# Defaults already enforce bit-identical results; override only if you know why.
# CLANG_STRICT_FP="-ffp-contract=off -fno-vectorize -fno-slp-vectorize"
# GCC_STRICT_FP="-ffp-contract=off -fno-tree-vectorize -fno-tree-loop-vectorize -fno-tree-slp-vectorize"
