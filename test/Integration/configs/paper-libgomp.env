# paper-libgomp.env — Figure 4: parallel speedup on libgomp,
# GCC frontend against ours, PolyBench/C LARGE.
#
#   cd test/Integration
#   RUN_ENV=configs/paper-libgomp.env PLOT=true ./run_performance.sh
#
# Expect hours: 30 kernels x 4 cells x 10 repetitions at LARGE.
#
# Less time, less confidence — an environment variable wins over this file, so
# the reduction goes on the command line and stays visible there:
#   REPS=5   halves it, keeps a (weak) standard deviation over 3 samples
#   REPS=3   3.3x faster, the median of three, no deviation at all
# The dataset is deliberately NOT the knob to turn: MEDIUM would change the
# memory pressure and the scaling regime, and the numbers would stop being
# comparable with the published figure. Fewer repetitions cost confidence in
# the value; a smaller dataset changes which value you are measuring.

RUNTIME="libgomp"
SUITE="full"
DATASET="LARGE_DATASET"
REPS="10"

# All hardware threads on the reference machine (8 physical cores with SMT),
# matching section 4.1 of the paper.
THREADS="16"

# Repeatability, not speed. Left at the runtime's own defaults a worker parks
# once its wait exceeds the block time, and every later region entry then pays
# a wake-up syscall per thread — a cost that depends on how the timing happened
# to fall rather than on the code under test. Without these, two runs of the
# SAME binary disagreed by 88% on durbin and by a factor of ten on trisolv.
OMP_WAIT_POLICY="ACTIVE"
GOMP_SPINCOUNT="infinite"
OMP_PROC_BIND="true"
OMP_PLACES="cores"
