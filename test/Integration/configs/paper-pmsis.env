# paper-pmsis.env — Figures 6 and 7: parallel speedup and binary size change
# on GAP8, PULP-SDK GCC against ours, through the gvsoc simulator.
#
#   cd test/Integration
#   RUN_ENV=configs/paper-pmsis.env PLOT=true ./run_performance.sh
#
# PLOT=true renders both figures here: the speedup chart and, because the
# size_* columns exist only on this target, a second ..._size.png beside it.
#
# There is no faster variant of this run, and the two knobs that give one on
# the host are both unavailable:
#   REPS      does not apply — gvsoc is deterministic, so every cell runs once
#             and repeating it would return the same cycle count
#   DATASET   already forced to MINI by common.sh; GAP8 has 64 KB of L1 and
#             512 KB of L2, and a larger set dies in pi_l2_malloc
# What is left is the kernel count, which is the one thing that cannot shrink
# without the figure ceasing to be the figure.
#
# Needs the GAP SDK, the gvsoc simulator and PULP_APP_DIR pointing at the
# PolyBench-PULP harness — see the PULP section of README.md.

RUNTIME="pmsis"

# DATASET, THREADS, REPS and the wait-policy variables are all deliberately
# absent: the cluster's core count is fixed by the harness NUM_CORES, and a
# bare-metal runtime has no thread parking to suppress.
